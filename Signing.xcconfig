// Who this checkout signs as.
//
// Every Apple-account-specific value in the project is gathered here, so
// building under a different developer account is one file, not a search
// through project.yml and three export plists.
//
// To build as yourself, do not edit this file. Create
// `Signing.local.xcconfig` beside it — it is gitignored, it is included at
// the bottom of this file, and anything it sets wins:
//
//     ISSA_TEAM_ID  = ABCDE12345
//     ISSA_BUNDLE_ID = com.yourname.issareader
//
// The bundle identifier has to match an App ID you own, so a fork needs its
// own regardless; the team ID alone is enough to build and run locally.

ISSA_TEAM_ID = D8455BV6NN
ISSA_BUNDLE_ID = com.benjaminissa.issareader

// The two App Store profiles Release pins to by name. macOS and tvOS sign
// manually because automatic signing mints a Development profile first and a
// Development profile enumerates device UDIDs, which this team has for iOS
// and no other platform — see docs/RELEASE.md. Both were created through the
// App Store Connect API; a fork creates its own and names them here.
ISSA_MACOS_PROFILE = macOS Store Provisioning Profile: com.benjaminissa.issareader
ISSA_TVOS_PROFILE = tvOS Store Provisioning Profile: com.benjaminissa.issareader

// Last, so a local override replaces anything above. `#include?` does not
// fail when the file is absent, which is the normal case.
#include? "Signing.local.xcconfig"
