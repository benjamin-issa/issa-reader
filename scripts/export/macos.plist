<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>upload</string>
  <!-- Manual for the same reason tvOS is: no registered Mac in the team, so
       automatic signing cannot mint the Development profile it looks for
       first. The profile below was created through the App Store Connect API
       against the UNIVERSAL App ID that already covers iOS and tvOS. -->
  <key>signingStyle</key>
  <string>manual</string>
  <!-- Both, explicitly. A Mac App Store export signs two things with two
       different identities — the .app with the distribution certificate, the
       .pkg around it with the installer one — and the profile has to list both
       or the export refuses. Left to choose, Xcode picked the installer
       certificate for the app and failed with "this identity cannot be used
       for signing code". -->
  <key>signingCertificate</key>
  <string>Apple Distribution</string>
  <key>installerSigningCertificate</key>
  <string>3rd Party Mac Developer Installer</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.benjaminissa.issareader</key>
    <string>macOS Store Provisioning Profile: com.benjaminissa.issareader</string>
  </dict>
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
  <key>teamID</key>
  <string>D8455BV6NN</string>
</dict>
</plist>
