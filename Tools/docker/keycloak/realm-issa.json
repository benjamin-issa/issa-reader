{
  "realm": "issa",
  "enabled": true,
  "displayName": "Issa Reader Dev",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "storyteller",
      "name": "Storyteller",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "storyteller-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://*/api/v2/auth/callback/keycloak",
        "http://*/*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "groups",
        "basic",
        "email"
      ]
    }
  ],
  "groups": [
    {
      "name": "readers"
    },
    {
      "name": "librarians"
    }
  ],
  "users": [
    {
      "username": "benjamin",
      "email": "benjamin@issa.test",
      "firstName": "Benjamin",
      "lastName": "Issa",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "reader",
          "temporary": false
        }
      ],
      "groups": [
        "/librarians"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "groups",
      "description": "Group membership, requested by Storyteller when group permissions are configured",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
