{
  "realm": "issa",
  "enabled": true,
  "displayName": "Issa Reader Dev",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "storyteller",
      "name": "Storyteller",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "storyteller-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8001/api/v2/auth/callback/keycloak",
        "http://localhost:8001/*",
        "http://host.docker.internal:8001/*"
      ],
      "webOrigins": ["*"],
      "attributes": { "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "groups": [{ "name": "readers" }, { "name": "librarians" }],
  "users": [
    {
      "username": "benjamin",
      "email": "benjamin@issa.test",
      "firstName": "Benjamin",
      "lastName": "Issa",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "reader", "temporary": false }],
      "groups": ["/librarians"]
    }
  ]
}
