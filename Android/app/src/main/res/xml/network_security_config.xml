<?xml version="1.0" encoding="utf-8"?>
<!--
    A Storyteller server is self-hosted, and often on a home network at a plain
    http:// address, so cleartext is allowed, as the iPhone app allows it
    (NSAllowsArbitraryLoads). HTTPS is used wherever the server offers it, and
    the sign-in screen warns when an address is not encrypted.

    User-installed certificate authorities are trusted as well as the system's,
    for servers behind a private CA.

    Not for the AI providers a reader can add their own key for: a request to
    Anthropic or OpenAI carries that key and passages of their book, so it goes
    over HTTPS only and trusts the system's authorities only — a certificate
    authority a user or a device policy installed cannot read it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.anthropic.com</domain>
        <domain includeSubdomains="false">api.openai.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
